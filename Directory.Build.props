<Project>
  <!-- Signing keys and store identities live in signing.local.props (not in git; see the .example). -->
  <Import Project="$(MSBuildThisFileDirectory)signing.local.props" Condition="Exists('$(MSBuildThisFileDirectory)signing.local.props')" />
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Authors>PFJ</Authors>
    <Product>Cascade 50</Product>
    <Description>Cascade 50 - fifty Oric-1 classics remade by PFJ, based on the Cascade Games originals.</Description>
    <Version>1.0.0</Version>
    <MonoGameVersion>3.8.5.1</MonoGameVersion>
    <!-- Store build number: bump for every App Store / Play / Partner Center upload. -->
    <BuildNumber>1</BuildNumber>
  </PropertyGroup>
</Project>
