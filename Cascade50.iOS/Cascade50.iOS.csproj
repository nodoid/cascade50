<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>uk.co.allthejohnsons.cascade50</ApplicationId>
    <ApplicationTitle>Cascade 50</ApplicationTitle>
    <ApplicationVersion>$(BuildNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <RootNamespace>Cascade50.iOS</RootNamespace>
    <AssemblyName>Cascade50</AssemblyName>
    <AppIcon>AppIcon</AppIcon>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>
  <!-- Signing keys come from signing.local.props; profiles are installed locally (not in git):
       devel-cascade50 for devices, rel-cascade50 for the App Store. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <CodesignKey>$(Cascade50DevSigningKey)</CodesignKey>
    <CodesignProvision>devel-cascade50</CodesignProvision>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>ios-arm64</RuntimeIdentifier>
    <CodesignKey>$(Cascade50DistSigningKey)</CodesignKey>
    <CodesignProvision>rel-cascade50</CodesignProvision>
    <ArchiveOnBuild>true</ArchiveOnBuild>
    <BuildIpa>true</BuildIpa>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cascade50.Core\Cascade50.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>
</Project>
