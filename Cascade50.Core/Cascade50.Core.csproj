<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Cascade50.Core</RootNamespace>
    <AssemblyName>Cascade50.Core</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against MonoGame only; each platform head supplies its own MonoGame runtime. -->
    <PackageReference Include="MonoGame.Framework.Native" Version="$(MonoGameVersion)">
      <PrivateAssets>All</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cascade50.Tests" />
  </ItemGroup>
</Project>
